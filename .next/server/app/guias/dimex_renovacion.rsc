0:["Y5MX4ZxVxvc-YkkiM6tfM",[[["",{"children":["guias",{"children":[["id","dimex_renovacion","d"],{"children":["__PAGE__?{\"id\":\"dimex_renovacion\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["guias",{"children":[["id","dimex_renovacion","d"],{"children":["__PAGE__",{},[["$L1",["$","$L2",null,{"guia":{"id":"dimex_renovacion","titulo":"Guía 4: Emisión y Renovación de Documento DIMEX","descripcion":"Para personas que ya cuentan con resolución de permanencia o refugio aprobada y requieren documentar su carné DIMEX por primera vez o por vencimiento.","aranceles":{"usd":128,"crc":67000,"detalle":"US$123 por emisión del documento de identidad migratoria + US$5 de comisión bancaria/postal de entrega."},"lugar":"Sucursales de Correos de Costa Rica (Ventanilla Electrónica VES) o Banco de Costa Rica autorizados.","cuenta_bancaria":"Pago directo en ventanilla de Correos de Costa Rica o Banco de Costa Rica al momento de la cita.","advertencia_fraude":"Las multas por DIMEX vencido son de US$3 por mes de retraso. Renueve con al menos 1 mes de anticipación para evitar recargos acumulados.","requisitos":[{"id":"dim_cita","texto":"Cita previa gestionada en Correos de Costa Rica (llamando al 1311 o en el portal oficial)."},{"id":"dim_anterior","texto":"Documento DIMEX original vencido o por vencer (o denuncia del OIJ si fue extraviado/robado)."},{"id":"dim_ccss","texto":"Comprobante de seguro social de la CCSS al día (orden patronal, carné de asegurado voluntario o seguro ACNUR)."},{"id":"dim_pago","texto":"Comprobante del pago total de aranceles y posibles multas por meses vencidos."}],"pasos":["Paso 1: Verifique su estatus en el sistema de la CCSS y asegúrese de que no reporta morosidad.","Paso 2: Llame al 1311 o ingrese a correos.go.cr para solicitar su cita de renovación DIMEX.","Paso 3: Acuda puntualmente a la oficina de Correos de Costa Rica (ej. Ciudad Quesada o Aguas Zarcas).","Paso 4: Realice la toma de fotografía y verificación dactilar en la ventanilla VES.","Paso 5: Retire el documento DIMEX en la sucursal asignada o recíbalo por mensajería segura."]}}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","guias","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","guias","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/35d8ad1eef9e5e53.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"es","children":[["$","head",null,{"children":["$","link",null,{"rel":"manifest","href":"/manifest.json"}]}],["$","body",null,{"className":"font-sans","children":[["$","$L6",null,{}],["$","main",null,{"className":"max-w-4xl mx-auto px-4 py-5 min-h-[calc(100vh-12rem)]","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1